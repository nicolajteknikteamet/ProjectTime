@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<ServerOptions> Options

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/">
            <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="#2a78d6"/><path d="M16 8v8l6 4" stroke="white" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
            <span>ProjectTime</span>
        </a>
        <NavMenu />
        <div class="sidebar-footer">
            @if (!string.IsNullOrEmpty(Options.Value.Password))
            {
                <form method="post" action="/logout"><button class="btn ghost small" type="submit">Logga ut</button></form>
            }
            <span class="muted tiny">Självhostad tidsspårning · all data stannar på din server</span>
        </div>
    </aside>
    <main class="content">
        @Body
    </main>
</div>
